<section id="boeken">

<div class="title">

<h2>
Boeking aanvragen
</h2>

<p>
Vul hieronder je gegevens in.
</p>

</div>


<div class="booking">

<form id="bookingForm">


<div class="form-grid">


<div class="field">

<label>
Naam
</label>

<input
id="name"
required
placeholder="Voor- en achternaam">

</div>



<div class="field">

<label>
Telefoonnummer
</label>

<input
id="phone"
required
placeholder="+32 ...">

</div>



<div class="field">

<label>
Villa
</label>

<select id="villa" required>

<option value="">
Kies een villa
</option>

<option>
Villa Brussel 1
</option>

<option>
Villa Brussel 2
</option>

<option>
Villa Brussel 3
</option>

<option>
Villa Antwerpen 1
</option>

<option>
Villa Antwerpen 2
</option>

<option>
Villa Antwerpen 3
</option>

<option>
Villa Gent 1
</option>

</select>

</div>



<div class="field">

<label>
Datum
</label>

<input
id="date"
type="date"
required>

</div>



<div class="field">

<label>
Type boeking
</label>

<select id="type">

<option>
Overdag — €150
</option>

<option>
Nacht — €250
</option>

</select>

</div>



<div class="field">

<label>
Aantal personen
</label>

<input
id="people"
type="number"
min="1"
required
placeholder="Bijvoorbeeld 8">

</div>



<div class="field full">

<label>
Extra informatie
</label>

<textarea
id="message"
placeholder="Heb je nog vragen of opmerkingen?">
</textarea>

</div>


</div>


<button
class="button"
type="submit">

Boeking aanvragen via WhatsApp

</button>


<div class="notice">

Een aanvraag is pas definitief nadat VillaVerhuur
de beschikbaarheid heeft bevestigd.

</div>


</form>

</div>

</section>



<footer>

<strong>
VillaVerhuur
</strong>

<br><br>

Villa's in Brussel · Antwerpen · Gent

<br><br>

© 2026 VillaVerhuur

</footer>



<script>

document.getElementById("date").min =
new Date().toISOString().split("T")[0];


document.getElementById("bookingForm")
.addEventListener("submit", function(e) {

e.preventDefault();


const name =
document.getElementById("name").value;

const phone =
document.getElementById("phone").value;

const villa =
document.getElementById("villa").value;

const date =
document.getElementById("date").value;

const type =
document.getElementById("type").value;

const people =
document.getElementById("people").value;

const message =
document.getElementById("message").value;


/*
VERVANG HIERONDER HET NUMMER
DOOR JOUW WHATSAPP-NUMMER.

Gebruik landcode zonder +.

Voorbeeld:
32470123456
*/

const whatsappNumber =
"32470000000";


const text =
"Hallo VillaVerhuur,%0A%0A" +

"Ik wil graag een boeking aanvragen.%0A%0A" +

"Naam: " +
encodeURIComponent(name) +

"%0ATelefoon: " +
encodeURIComponent(phone) +

"%0AVilla: " +
encodeURIComponent(villa) +

"%0ADatum: " +
encodeURIComponent(date) +

"%0ABoeking: " +
encodeURIComponent(type) +

"%0AAantal personen: " +
encodeURIComponent(people) +

"%0AExtra informatie: " +
encodeURIComponent(message || "Geen");


window.open(
"https://wa.me/" +
whatsappNumber +
"?text=" +
text,
"_blank"
);

});

</script>

</body>
</html>
