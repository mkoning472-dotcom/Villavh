<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>VillaVerhuur | Villa's in België</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f7f5f1;
    color: #222;
}

header {
    background: #111;
    color: white;
    padding: 18px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 10;
}

.logo {
    font-size: 25px;
    font-weight: bold;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
}

.hero {
    background: linear-gradient(135deg, #111, #555);
    color: white;
    padding: 90px 7%;
    min-height: 470px;
    display: flex;
    align-items: center;
}

.hero-content {
    max-width: 700px;
}

.hero h1 {
    font-size: 55px;
    margin: 0 0 20px;
}

.hero p {
    font-size: 20px;
    line-height: 1.5;
}

.button {
    display: inline-block;
    background: white;
    color: #111;
    padding: 14px 23px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
    margin-top: 15px;
}

section {
    padding: 60px 6%;
    max-width: 1200px;
    margin: auto;
}

.title {
    text-align: center;
    margin-bottom: 35px;
}

.title h2 {
    font-size: 35px;
    margin-bottom: 10px;
}

.title p {
    color: #666;
}

.villas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
}

.card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
}

.photo {
    height: 190px;
    background: linear-gradient(135deg, #cfc8bc, #777);
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    font-size: 18px;
}

.card-content {
    padding: 20px;
}

.card h3 {
    margin-top: 0;
    font-size: 22px;
}

.price {
    font-size: 19px;
    font-weight: bold;
    margin: 12px 0;
}

.info {
    color: #666;
    line-height: 1.6;
}

.card .button {
    background: #111;
    color: white;
    width: 100%;
    text-align: center;
}

.prices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
}

.price-box {
    background: white;
    padding: 30px;
    border-radius: 15px;
    text-align: center;
    box-shadow: 0 5px 20px rgba(0,0,0,0.07);
}

.price-box h3 {
    font-size: 24px;
}

.big-price {
    font-size: 35px;
    font-weight: bold;
}

.booking {
    background: #111;
    color: white;
    border-radius: 18px;
    padding: 35px;
    max-width: 850px;
    margin: auto;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.field {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.full {
    grid-column: 1 / -1;
}

input,
select,
textarea {
    padding: 13px;
    border-radius: 8px;
    border: 1px solid #ccc;
    font-size: 16px;
}

textarea {
    min-height: 100px;
}

.booking button {
    width: 100%;
    border: none;
    cursor: pointer;
}

.notice {
    margin-top: 15px;
    color: #bbb;
    font-size: 13px;
    line-height: 1.5;
}

footer {
    background: #111;
    color: #aaa;
    text-align: center;
    padding: 35px;
}

@media(max-width: 650px) {

    nav {
        display: none;
    }

    .hero {
        padding: 70px 6%;
    }

    .hero h1 {
        font-size: 42px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .full {
        grid-column: auto;
    }
}
</style>
</head>

<body>

<header>

<div class="logo">
VillaVerhuur
</div>

<nav>
<a href="#villas">Villa's</a>
<a href="#prijzen">Prijzen</a>
<a href="#boeken">Boeken</a>
</nav>

</header>


<section class="hero">

